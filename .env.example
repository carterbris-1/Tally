# Copy to .env.local and fill in from your Supabase project settings (API section).
# Both are safe to expose — the anon key is designed to be public, and row-level
# security is what actually protects the data. Run supabase/schema.sql first.
VITE_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-KEY

# Optional. The daily read pulls papers from OpenAlex, which serves anonymous requests
# from a daily budget shared by every device on your IP. A single user will not hit it;
# a shared network can, and then papers quietly stop appearing until midnight UTC.
# A key is free (https://openalex.org/) and removes the limit.
VITE_OPENALEX_KEY=
